# ──────────────────────────────────────────────
# EQEmulator.dev — Environment Configuration
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────

# Domain (your public hostname)
DOMAIN=eqemu.example.com

# ── MariaDB ──
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=eqemu_login
DB_USER=eqemu_ls
DB_PASSWORD=change_me_db_password
DB_WEB_USER=eqemu_web
DB_WEB_PASSWORD=change_me_web_password

# ── Loginserver ──
# API token must match the value seeded into login_api_tokens table
LOGINSERVER_API_TOKEN=change_me_api_token

# ── Web Application ──
# 64+ character random string for session cookie encryption
SESSION_SECRET=change_me_session_secret_64_chars_minimum

# Public URL of this node (used for email links, redirects)
NEXT_PUBLIC_SITE_URL=https://eqemu.example.com
NEXT_PUBLIC_APP_URL=https://eqemu.example.com

# ── Cloudflare Turnstile (registration captcha) ──
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Resend (email verification + MFA codes) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@eqemu.example.com

# ── Federation ──
# Shared secret for sync endpoint authentication between nodes
FEDERATION_SYNC_SECRET=change_me_federation_sync_secret

# Encryption key for private keys stored at rest (32+ chars)
FEDERATION_KEY_ENCRYPTION_SECRET=change_me_key_encryption_secret

# ── Monitoring (optional) ──
PROMETHEUS_URL=http://prometheus:9090
METRICS_BEARER_TOKEN=change_me_metrics_token
REDIS_URL=redis://redis:6379
