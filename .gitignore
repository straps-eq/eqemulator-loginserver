# Environment and secrets
.env
.env.local
.env.production

# Database data
mariadb/data/

# SSL certificates
certbot/conf/
certbot/www/

# Loginserver runtime config (contains DB password)
loginserver/login.json

# Loginserver compiled data
loginserver/data/

# Backups
backups/

# Prometheus data
prometheus/data/

# OS files
.DS_Store
Thumbs.db

# nginx runtime config (contains your domain — use .example as template)
nginx/conf.d/default.conf

# User-uploaded content
web/public/uploads/

# IDE
.vscode/
.idea/
.windsurf/
uploads/
docker-compose.yml.bak
nginx/conf.d/default.conf.bak

# Self-updater (scripts/deploy.sh) — node-local state, never committed
versions.env
versions.env.previous
updater.conf
.upgrade.lock
.deploy-stage/
state/*
!state/.gitkeep
nginx/conf.d/default.conf.bak*

# Runtime logs written on the node
logs/*.log
